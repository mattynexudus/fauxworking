#!/usr/bin/env bash
# fauxworking — the friendly front door to this tool.
#
# Usage:
#   ./fauxworking            Same as "wizard" — the guided setup (recommended)
#   ./fauxworking wizard     Interactive step-by-step setup
#   ./fauxworking teardown   Undo everything this tool created
#   ./fauxworking verify     Check what's actually in the account
#   ./fauxworking daily      Add a fresh day's worth of activity
#   ./fauxworking refresh    Pull in auto-generated invoices + export invoice lines
#   ./fauxworking ui         Open the local control panel in your browser
#
# Anything after the command is passed straight through, e.g.:
#   ./fauxworking wizard --business-id 12345
#
# This is a thin dispatcher — see README.md for what each command actually
# does, and the "Getting more control" section for the underlying scripts
# and individual generators this wraps.
set -euo pipefail
cd "$(dirname "$0")"

cmd="${1:-wizard}"
if [[ "$#" -gt 0 ]]; then
  shift
fi

case "$cmd" in
  wizard)
    python3 wizard.py "$@"
    ;;
  teardown)
    bash scripts/teardown.sh "$@"
    ;;
  verify)
    bash scripts/verify.sh "$@"
    ;;
  daily)
    bash scripts/daily.sh "$@"
    ;;
  refresh)
    bash scripts/refresh.sh "$@"
    ;;
  ui)
    bash scripts/ui.sh "$@"
    ;;
  -h|--help|help)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Unknown command: $cmd"
    echo ""
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
